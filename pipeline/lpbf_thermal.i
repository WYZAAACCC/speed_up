# =============================================================================
# LPBF 温度场模块（两阶段共用）—— 移动高斯热源的 Rosenthal 解
# =============================================================================
#
# 用法：在阶段一/阶段二的输入文件里用 !include 引入，或直接复制此块。
#
#     !include lpbf_thermal.i
#
# 然后在需要的地方：
#     [AuxVariables]
#       [T]  []
#     []
#     [AuxKernels]
#       [T_field]
#         type = FunctionAux
#         variable = T
#         function = laser_T
#       []
#     []
#     并在 GrainGrowthAction 里：variable_mobility = true, coupled_variables = 'T'
#
# =============================================================================
# 【单位约定】本模块用 SI：长度 m、时间 s。网格也必须是米。
#   熔池尺度 ~1e-4 m，所以网格 xmax ~ 1e-3 量级。
#
# 【参数与实测熔池尺寸】（由 pipeline/thermal_field.py 标定，2026-09-17）
#   P=300 W, eta=0.35 -> 吸收 105 W
#   v=0.6 m/s, rb=30 um, T0=353 K
#   熔池宽度  95.1 um
#   熔池深度  47.6 um
#   前缘      28.8 um
#   尾部     513.2 um        <- 注意：尾部很长，见下方【已知局限】
#   冷却速率  1.79e6 K/s     <- 落在 LPBF 真实区间
#
# 【已知局限】（明确记录，不装作没有）
#   1. 无对流 / Marangoni / 潜热 / 多次重熔
#   2. 点源解在 R->0 处发散（下面用 max(...,1e-6) 兜底）。
#      近轴温度非物理，但熔池边界（T=T_L 等温线）在 r >> rb 处，是准的。
#   3. **尾部长度被高估**。点源解在激光后方指数因子恒为 1，
#      温度按 1/|xi| 衰减，于是尾长 = eta*P/(2*pi*k*(T_L-T0))，
#      **与扫描速度无关** —— 这是点源模型的固有假象。
#      真实熔池尾部因光束是分布源而短得多。
#      后果：计算域必须比真实熔池长，或把功率调低。
#      -> 若要把域做小，降低 P；但 P 太低会让熔池小于光束半径，
#         点源假设失效。这个矛盾见 LPBF方案_单熔池.md §二。
# =============================================================================

[Functions]
  [laser_T]
    type = ParsedFunction
    # T = T_room + eta*P/(2*pi*k*R) * exp(-v*(R+xi)/(2*alpha))
    #   xi = x - v*t   随激光移动的坐标
    #   R  = |(xi, y, z)|，下限 1e-6 m 避免除零
    expression = '300.0 + 105/(2*pi*20.0*R)*exp(-0.6*(R+xi)/(2*6e-06))'
    symbol_names = 'xi R'
    symbol_values = 'x-0.6*t  max(sqrt((x-0.6*t)^2 + y^2 + z^2), 1e-06)'
  []

  # 只降温不移动：阶段二用（冷却曲线，指数衰减）
  # T(t) = T_room + (T_solidus - T_room) * exp(-t/tau)
  # tau 由目标冷速定：LPBF 冷速 1e4-1e6 K/s -> tau 约 1e-3 - 1e-4 s
  [cooling_T]
    type = ParsedFunction
    expression = '300.0 + (1878.0-300.0)*exp(-t/1e-3)'
  []
[]
